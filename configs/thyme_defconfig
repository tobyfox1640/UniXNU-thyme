# Xiaomi Mi 10S / SM8250: initial source-kernel configuration.
# Early kernel entry/MMU/arm_vm_init verified on 2026-10-20; bring-up continues.
# ArmCpu requires a source crypto provider and ArmDTPlatform.
# The link needs the source archives ([kernel] archives of board.toml).
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# "prelinked": the donor kernelcache's com.apple.kec.corecrypto (pulled in as a
# dependency of AppleMobileFileIntegrity) initializes XNU's PRNG through real
# OSKext startup. "source" would run the linked-in bootstrap first at
# STARTUP(EARLY_BOOT) and trip prng_random.c's assert(!prng_ready) when the
# donor kext registers a second time. Both providers stay linked; only the
# early source entry is omitted.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# No QEMU platform or unqualified sheng hardware/root-volume paths.
CONFIG_XNU_ARMVIRT_PLATFORM=n
# On: AppleMobileFileIntegrity refuses to load without an ApplePMGR service
# (panic "AMFI: No PMGR" @ConfigurationSettings.cpp:235). The base patch
# patches/xnu/sheng-platform-power.patch calls sheng_pmgr_run() from bsd_init()
# for exactly this, and scripts/build-thyme-platform-power.py supplies it.
CONFIG_XNU_SHENG_PMGR=y
# UFS is the only path to the root volume: the userdata partition holds the
# OS/SystemOS images. NativeUfs builds on the qualified AES closure.
CONFIG_XNU_NATIVE_UFS=y
# Bring-up: serve UFS reads without the owner-signed root policies,
# which need the donor volume image and keys. Set to 1 once they exist.
CONFIG_XNU_THYME_VERIFIED_BLOCK=0
# Bind the source AES subclass to the original kernelcache methods; required by
# NativeUfs (and by the verified-root stack later).
CONFIG_XNU_NATIVE_AES=y
# The IOBlockStorageDevice KPI class has no implementation in the source kernel:
# the bindings archive supplies its constructor, destructor, meta class and
# vtable from the donor kernelcache. NativeUfs needs them (the same archive the
# reference ports link), so the VirtIO component is what carries the bindings.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_RAM_BLOCK=n
# Enabled by build_thyme_xnu.py for the prelinked --owner-root profile.
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
# The UFS driver carries gRootDiagnostic and native_ufs_* counters but nothing
# prints them; the owner root audit plus the boot progress checkpoints put the
# stage it reaches on the screen, which is the only log channel available.
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
# Required with the BCM2837 build target: n falls back to its fixed panic PA.
# Only a validated pram node may supply a panic buffer; thyme currently has none.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n
# SM8250 implements PAN; copyin/copyout must manage it on exception entry.
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_BOOT_PROGRESS=y
# On: the base patch set references the legacy display probes from bsd_init.c;
# thyme links an empty stub until the real display stack is ported.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_ADRENO_FIRMWARE_PROBE=n
CONFIG_XNU_ADRENO_PM4_PROBE=n
CONFIG_XNU_SMMU4K_PROBE=n
CONFIG_XNU_CONSTANT_UPLOADS_PROBE=n
CONFIG_XNU_NATIVE_OFFLINE_GPU=n
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
